generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}



enum TipoUsuario {
  ADMIN
  PROFESSOR
}


enum Categoria {
  INICIAIS
  FINAIS
}


enum StatusPedido {
  PENDENTE
  EM_USO
  RETIRADA_SOLICITADA
  FINALIZADO
}



model Usuario {

  id Int @id @default(autoincrement())

  nome String

  email String @unique

  senha String

  tipo TipoUsuario


  professor Professor?


  createdAt DateTime @default(now())

}



model Professor {

  id Int @id @default(autoincrement())


  usuarioId Int @unique

  usuario Usuario @relation(fields: [usuarioId], references: [id])


  categoria Categoria


  pedidos Pedido[]

}



model Notebook {

  id Int @id @default(autoincrement())


  categoria Categoria @unique


  total Int

  disponivel Int

  emUso Int

}



model Pedido {

  id Int @id @default(autoincrement())


  professorId Int

  professor Professor @relation(fields: [professorId], references: [id])


  sala String


  quantidade Int


  status StatusPedido @default(PENDENTE)


  createdAt DateTime @default(now())

}

